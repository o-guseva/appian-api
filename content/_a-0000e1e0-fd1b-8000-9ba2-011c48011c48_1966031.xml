    <versionUuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_58315</versionUuid>
    <rule>
        <name>IEM_ICO_FORMAT_PhoneNumber</name>
        <uuid>_a-0000e1e0-fd1b-8000-9ba2-011c48011c48_1966031</uuid>
        <description>Formats domestic and international phone numbers &lt;br&gt;
If no input given, returns input</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!phoneNumber: cleanwith(ri!phoneNumber, #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_58241"),
  a!match(
    value: local!phoneNumber,
    whenTrue: len(local!phoneNumber) = 10,
    then: text(local!phoneNumber, #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_58257"),
    whenTrue: and(len(local!phoneNumber) &gt; 10, len(local!phoneNumber) &lt; 15),
    then: text(local!phoneNumber, #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_58263"),
    default: ri!phoneNumber
  )
)</definition>
        <namedTypedValue>
            <name>phoneNumber</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
