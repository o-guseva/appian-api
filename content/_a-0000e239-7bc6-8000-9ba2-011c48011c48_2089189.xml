    <rule>
        <name>IEM_ICO_GENERATE_UniqueElements</name>
        <uuid>_a-0000e239-7bc6-8000-9ba2-011c48011c48_2089189</uuid>
        <description>Returns the unique elements within an array</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  a!isNullOrEmpty(ri!array),
  null,
  union(ri!array, ri!array)
)</definition>
        <namedTypedValue>
            <name>array</name>
            <type>
                <name>Variant</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
