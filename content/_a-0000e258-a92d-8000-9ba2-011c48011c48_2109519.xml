<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_58321</versionUuid>
    <rule>
        <name>IEM_ICO_GENERATE_LongestString</name>
        <uuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2109519</uuid>
        <description>Generates the longer of given list of strings</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(a!isNullOrEmpty(ri!values),
  "",
  a!localVariables(
    local!lengths: 
    #"SYSTEM_SYSRULES_forEach"(
      items: ri!values,
      expression: len(fv!item)
    ),
    local!lengthLongest: tointeger(max(local!lengths)),
    local!indexLongestString: wherecontains(local!lengthLongest, local!lengths),
    index(ri!values, local!indexLongestString, ri!values)
  )
)</definition>
        <namedTypedValue>
            <name>values</name>
            <type>
                <name>Text?list</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
    <roleMap public="true">
