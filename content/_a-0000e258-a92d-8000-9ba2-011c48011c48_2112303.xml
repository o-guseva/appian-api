<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000ef0f-9abf-8000-af69-01ef9001ef90_310592</versionUuid>
    <rule>
        <name>IEM_ICO_FORMAT_DateTime</name>
        <uuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2112303</uuid>
        <description>formats a dateTime into a text string. used for consistency across the application</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  /*NOTE TO SELF: CHANGE TO TYPES INSTEAD OF TOGGLES */
  local!type: typeof(ri!value),
  local!isVerbose: a!defaultValue(value: ri!isVerbose, default: true),
  local!isShortenedMonth: a!defaultValue(value: ri!isShortenedMonth, default: true),
  local!includeTimezone: a!defaultValue(value: ri!includeTimezone, default: true),
  if(a!isNullOrEmpty(ri!value),
    a!defaultValue(value: ri!default, default: ri!value),
    a!match(
      value: local!type,
      whenTrue: local!type = 9,
      then: text(ri!value, if(local!isVerbose, if(local!isShortenedMonth, "mmm", "mmmm") &amp; " d, yyyy", "m/d/yyyy") &amp; " h:mm AM/PM" &amp; if(local!includeTimezone, "z", "")),
      default: a!defaultValue(value: ri!default, default: ri!value)
    )
  )
)</definition>
        <namedTypedValue>
            <name>value</name>
            <type>
                <name>dateTime</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>isVerbose</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>isShortenedMonth</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>includeTimezone</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>default</name>
            <type>
                <name>Variant</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
