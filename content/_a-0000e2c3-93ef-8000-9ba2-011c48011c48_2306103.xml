<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_59070</versionUuid>
    <rule>
        <name>IEM_ICO_EXTRACT_Excel</name>
        <uuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2306103</uuid>
        <description>given an excel sheet returns a dictionary of the column names and values for that excel sheet. </description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!sheetContents: readexcelsheet(
    excelDocument: ri!spreadsheet, 
    sheetNumber: 0, 
    startRow: 1
  ),
  {
    columnNames: reject(
      a!isNullOrEmpty(_),
      index(
        local!sheetContents.result[1],
        "values",
        {}
      )
    ),
    result: remove(
      index(
        local!sheetContents,
        "result",
        {}
      ),
      1
    )
  }
)</definition>
        <namedTypedValue>
            <name>spreadsheet</name>
            <type>
                <name>CollaborationDocument</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
    <roleMap public="true">
