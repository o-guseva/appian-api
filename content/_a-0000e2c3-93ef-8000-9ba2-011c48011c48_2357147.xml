    <versionUuid>_a-0000ec66-328d-8000-af46-01ef9001ef90_116035</versionUuid>
    <rule>
        <name>IEM_ICO_FORMAT_User</name>
        <uuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2357147</uuid>
        <description>Formats user's Appian display name</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(isnull(ri!user),
  "",
  if(isusernametaken(ri!user),
    if(ri!isUserRecordLink,
      #"SYSTEM_SYSRULES_userRecordLink"(
        label: trim(user(ri!user, "firstName") &amp; " " &amp; user(ri!user, "middleName") &amp; " " &amp; user(ri!user, "lastName")),
        user: ri!user,
        openLinkIn: "NEW_TAB"
      ),
      trim(user(ri!user, "firstName") &amp; " " &amp; user(ri!user, "middleName") &amp; " " &amp; user(ri!user, "lastName"))
    ),
    if(ri!isUserRecordLink,
      #"SYSTEM_SYSRULES_userRecordLink"(
        label: tostring(ri!user),
        user: ri!user,
        openLinkIn: "NEW_TAB"
      ),
      tostring(ri!user)
    )
  )
)</definition>
        <namedTypedValue>
            <name>user</name>
            <type>
                <name>User</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>isUserRecordLink</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
