    <interface>
        <name>IEM_ICO_CMPT_ToggleArrow</name>
        <uuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2430310</uuid>
        <description>Arrow Toggle for showing and hiding interfaces</description>
        <parentUuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2110934</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  /*DEFAULTS*/
  local!label: trim(ri!label &amp; " "),
  local!color: a!defaultValue(value: ri!color, default: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_59831"),
  
  local!selectedIsShowing: false,
  
  #"SYSTEM_SYSRULES_richTextDisplayField"(
    labelPosition: "COLLAPSED",
    value: 
    #"SYSTEM_SYSRULES_richTextItem_v1"(
      text: 
      if(local!selectedIsShowing = true,
        concat(
          local!label,
          #"_a-0000e1c3-d94d-8000-9ba2-011c48011c48_1939917"
        ),
        concat(
          local!label,
          #"_a-0000e1c3-d94d-8000-9ba2-011c48011c48_1939923"
        )
      ),
      link: 
      #"SYSTEM_SYSRULES_dynamicLink"(
        value: not(local!selectedIsShowing),
        saveInto: {
          local!selectedIsShowing,
          ri!saveInto
        }
      ),
      color: local!color
    ),
    showWhen: ri!showWhen
  )
)</definition>
