<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000ec7b-b642-8000-3cc0-01ef9001ef90_145779</versionUuid>
    <rule>
        <name>IEM_ICO_GENERATE_ContentObjectIdIntoJson</name>
        <uuid>_a-0000e338-32ac-8000-9ba2-011c48011c48_2585361</uuid>
        <description>[try] [Plug-in: Check Object Existence]</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!string: 
  if(a!isNullOrEmpty(ri!object),
    null,
    getcontentobjectdetailsbyid(ri!object)
  ),
  local!subString: "Content Object",
  if(or(
      a!isNullOrEmpty(local!string),
      a!isNullOrEmpty(local!subString)
    ),
    null,
    #"SYSTEM_SYSRULES_fromJson_v1"(
      #"_a-0000e338-32ac-8000-9ba2-011c48011c48_2600839"(
        json: 
        trim(
          mid(
            local!string,
            len(
              concat(local!subString, " ")
            ),
            len(
              local!string
            ) - len(
              local!subString
            )
          )
        )
      )
    )
  )
)</definition>
        <namedTypedValue>
            <name>object</name>
            <type>
                <name>Variant</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
