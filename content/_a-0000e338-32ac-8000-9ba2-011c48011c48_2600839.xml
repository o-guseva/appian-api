<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000eacb-bb97-8000-3c9f-01ef9001ef90_70301</versionUuid>
    <rule>
        <name>IEM_ICO_GENERATE_ConvertJsonToAppianSafe</name>
        <uuid>_a-0000e338-32ac-8000-9ba2-011c48011c48_2600839</uuid>
        <description>Converts JSON to Appian-safe format</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>substitute(
  substitute(
    substitute(
      substitute(
        ri!json,
        "[",
        "{"""
      ),
      "]",
      """}"
    ),
    ", ",
    """, """
  ),
  ": ",
  """: """
)</definition>
        <namedTypedValue>
            <name>json</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
    <roleMap public="true">
        <role inherit="true" allowForAll="false" name="readers">
            <users/>
            <groups/>
        </role>
        <role inherit="true" allowForAll="false" name="authors">
