    <rule>
        <name>IEM_ICO_FORMAT_ReverseString</name>
        <uuid>_a-0000e338-32ac-8000-9ba2-011c48011c48_2639637</uuid>
        <description>returns string with reversed character order</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!stringReversed: concat(reverse(char(code(ri!string)))),
  a!match(
    value: ri!casing,
    equals: #"_a-0000ea69-23b6-8000-3c9b-01ef9001ef90_55955"[1],
    then: proper(local!stringReversed),
    equals: #"_a-0000ea69-23b6-8000-3c9b-01ef9001ef90_55955"[2],
    then: 
    a!localVariables(
      local!delimiter: a!defaultValue(value: ri!delimiter, default: " "),
      local!stringReversedSplit: split(local!stringReversed, local!delimiter),
      local!stringReversedSplitFormatted: 
      #"SYSTEM_SYSRULES_forEach"(
        items: local!stringReversedSplit,
        expression: proper(fv!item)
      ),
      concat(local!stringReversedSplitFormatted)
    ),
    equals: #"_a-0000ea69-23b6-8000-3c9b-01ef9001ef90_55955"[3],
    then: lower(local!stringReversed),
    equals: #"_a-0000ea69-23b6-8000-3c9b-01ef9001ef90_55955"[4],
    then: upper(local!stringReversed),
    default: local!stringReversed
  )
)</definition>
        <namedTypedValue>
            <name>string</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>casing</name>
            <description>Optional
For determining casing of output
Uses IEM_ICO_OPTIONS_CASING to determine options</description>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>delimiter</name>
            <description>Optional
Provide if reversing between segments of text is neccessary
e.g. "Ozymandias-Toast" -&gt; " "</description>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
