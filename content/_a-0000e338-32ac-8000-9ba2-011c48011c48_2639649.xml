    <rule>
        <name>IEM_ICO_STRIP_Extension</name>
        <uuid>_a-0000e338-32ac-8000-9ba2-011c48011c48_2639649</uuid>
        <description>strips extension from filename</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!split: split(ri!filename, "."),
  local!splitCount: count(local!split),
  tostring(local!split[rdrop(enumerate(local!splitCount) + 1, 1)])
)</definition>
        <namedTypedValue>
            <name>filename</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
