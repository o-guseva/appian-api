<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000eacb-bb97-8000-3c9f-01ef9001ef90_70297</versionUuid>
    <rule>
        <name>IEM_ICO_GENERATE_DateIntervalGivenDates</name>
        <uuid>_a-0000e3aa-82f3-8000-9ba4-011c48011c48_3269820</uuid>
        <description>Given dates, generates the dateTime values until then. &lt;br&gt;
Results are based on EST timezone</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(ri!dateFrom &gt; ri!dateTo,
  null,
  a!localVariables(
    local!dateFrom: a!defaultValue(value: ri!dateFrom, default: today()),
    local!dateTo: a!defaultValue(value: ri!dateTo, default: today() + 1),
    local!elapsedDays: elapseddays(todatetime(local!dateFrom), todatetime(local!dateTo)),
    if(local!dateTo = today(),
      datetime(
        year(local!dateTo),
        month(local!dateTo),
        day(local!dateTo),
        4,
        0,
        0
      ),
      if(ri!isMultiInterval = true, 
        /*MULTI INTERVAL*/
        #"_a-0000e239-7bc6-8000-9ba2-011c48011c48_2089189"(
          array: a!flatten(#"SYSTEM_SYSRULES_forEach"(
          items: enumerate(local!elapsedDays),
          expression: 
          {
            datetime(
              year(local!dateFrom + (fv!index - 1)),
              month(local!dateFrom + (fv!index - 1)),
              day(local!dateFrom + (fv!index - 1)),
              4,
              0,
              0
            ),
            adddays(
              datetime(
                year(local!dateFrom + (fv!index - 1)),
                month(local!dateFrom + (fv!index - 1)),
                day(local!dateFrom + (fv!index - 1)),
                4,
                0,
                0
              ),
              1
            )
          }
        ))),
        /*SINGLE INTERVAL*/
        {
          datetime(
            year(today()),
            month(today()),
            day(today()),
            4,
            0,
            0
          ),
          adddays(
            datetime(
              year(today()),
              month(today()),
              day(today()),
              4,
              0,
              0
            ),
            local!elapsedDays
          )
        }
      )
    )
  )
)</definition>
        <namedTypedValue>
            <name>dateFrom</name>
            <description>Optional - Default is CURRENT DATE</description>
            <type>
                <name>date</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>dateTo</name>
            <type>
                <name>date</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>isMultiInterval</name>
            <description>Optional - Returns a breakout of each date between the two given dates</description>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
