<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_58346</versionUuid>
    <rule>
        <name>IEM_ICO_GENERATE_CleanFilename</name>
        <uuid>_a-0000e45b-3a6f-8000-9ba6-011c48011c48_3356751</uuid>
        <description>This rule will clean the file name supplied of unneeded spaces and commas</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>trim(substitute(substitute(substitute(ri!fileName,",",""),"[",""),"]","") )</definition>
        <namedTypedValue>
            <name>fileName</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
