    <rule>
        <name>IEM_ICO_FORMAT_Dollar</name>
        <uuid>_a-0000e45b-3a6f-8000-9ba6-011c48011c48_3361909</uuid>
        <description>Formats the given amount as dollars. Cents are shown by default unless explicitly toggled off.</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!showCents: a!defaultValue(value: ri!showCents, default: true),
  if(a!isNullOrEmpty(ri!amount),
    a!defaultValue(value: ri!defaultValue, default: null),
    #"urn:appian:function:v1:a:currency"(
      isoCode: "USD",
      value: if(local!showCents, round(ri!amount, 2), round(ri!amount, 0)),
      decimalPlaces: if(local!showCents, 2, 0)
    )
    /*concat(*/
      /*if(ri!amount &lt; 0, "-", ""),*/
      /*stripwith(*/
        /*if(local!showCents,*/
          /*dollar(round(ri!amount, 2)),*/
          /*rdrop(split(dollar(round(ri!amount, 0)), "."), 1)*/
        /*), "()"*/
      /*)*/
    /*)*/
  )
)</definition>
        <namedTypedValue>
            <name>amount</name>
            <type>
                <name>double</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>showCents</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>defaultValue</name>
            <description>Optional</description>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
