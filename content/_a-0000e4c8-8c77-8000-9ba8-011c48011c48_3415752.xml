            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  ri!date &lt; today(),
  #"_a-0000e4c8-8c77-8000-9ba8-011c48011c48_3415758",
