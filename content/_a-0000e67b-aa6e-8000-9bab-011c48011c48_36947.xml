<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000ed1a-a053-8000-3ccd-01ef9001ef90_210507</versionUuid>
    <rule>
        <name>IEM_ICO_GENERATE_LastWordInText</name>
        <uuid>_a-0000e67b-aa6e-8000-9bab-011c48011c48_36947</uuid>
        <description>This will take in a string and return the last word. If the string has only one word, that word is returned.</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  find(ri!delimiter, ri!value) = 0,
  ri!value,
  substitute(
    upper(mid(
      ri!value,
      max(wherecontains(
        " ",
        #"SYSTEM_SYSRULES_forEach"(
          items: enumerate(len(ri!value)),
          expression: ri!value[fv!index]
        )
      )) + 1,
      len(ri!value) - max(wherecontains(
        " ",
        #"SYSTEM_SYSRULES_forEach"(
          items: enumerate(len(ri!value)),
          expression: ri!value[fv!index]
        )
      ))
    )),
    "#",
    ""
  )
)</definition>
        <namedTypedValue>
            <name>value</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>delimiter</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
