    <rule>
        <name>IEM_ICO_VALIDATE_Email</name>
        <uuid>_a-0000e67b-aa6e-8000-9bab-011c48011c48_37003</uuid>
        <description>Returns the validation message if the text is not a valid email, ie. example@example.co</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  or(
    a!isNullOrEmpty(ri!value),
    #"_a-0000e695-f389-8000-9bae-011c48011c48_64839"(value: ri!value),
  ),
  null,
  "Please enter a valid email address"
)</definition>
        <namedTypedValue>
            <name>value</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
