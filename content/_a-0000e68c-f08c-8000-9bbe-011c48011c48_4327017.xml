<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60847</versionUuid>
    <rule>
        <name>IEM_ICO_GENERATE_TruncatedText</name>
        <uuid>_a-0000e68c-f08c-8000-9bbe-011c48011c48_4327017</uuid>
        <description>Truncate a text value</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  isnull(ri!charLimit),
  ri!value,
  if(
    len(ri!value) &gt; ri!charLimit,
    /*Ellipsis is only a single character but its wide enough that it 
    takes up the space of two characters, so trim down to the limit - 2
    so that the resulting string is approximately the same length as a 
    string of len = limit */
    left(ri!value, ri!charLimit - 2) &amp; "…",
    ri!value
  )
)</definition>
        <namedTypedValue>
            <name>value</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>charLimit</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
