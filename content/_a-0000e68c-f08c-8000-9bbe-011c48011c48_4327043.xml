    <interface>
        <name>IEM_ICO_CMPT_TruncatedTextField</name>
        <uuid>_a-0000e68c-f08c-8000-9bbe-011c48011c48_4327043</uuid>
        <description>Field for truncated text</description>
        <parentUuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2110934</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  ri!showWhen = false,
  {},
  a!localVariables(
    /*DEFAULTS*/
    local!charLimit: a!defaultValue(value: ri!charLimit, default: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60722"),
    local!isShowMoreOnNewLine: a!defaultValue(value: ri!isShowMoreOnNewLine, default: true),
    local!selectedShowMore: false,
    
    /*CALC*/
    local!isOverMaxLength: len(ri!value) &gt; local!charLimit,
    local!link: a!refreshVariable(
      refreshAlways: true,
      value: if(
        local!isOverMaxLength,
        #"SYSTEM_SYSRULES_dynamicLink"(
          saveInto: {
            a!save(local!selectedShowMore, not(local!selectedShowMore)),
            ri!saveInto
          }
        ),
        null
      )
    ),
    local!richTextItems: {
      if(
        not(local!isOverMaxLength),
        #"SYSTEM_SYSRULES_richTextItem_v1"(text: ri!value, color: ri!color),
        {
          #"SYSTEM_SYSRULES_richTextItem_v1"(
            text: if(
              local!selectedShowMore,
              ri!value,
              #"_a-0000e68c-f08c-8000-9bbe-011c48011c48_4327017"(
                value: ri!value,
                charLimit: local!charLimit
              )
            ),
            color: ri!color
          ),
          if(local!isOverMaxLength,
            {
              if(local!isShowMoreOnNewLine, 
                char(10),
                " "
              ),
              #"SYSTEM_SYSRULES_richTextItem_v1"(
                text: if(local!selectedShowMore, "(Show Less)", "(Show More)"),
                color: ri!colorLink,
                linkStyle: "STANDALONE",
                link: local!link
              )
            },
            {}
          )
        }
      )
    },
    local!result: 
    if(ri!wrapInRichTextDisplay = false,
      local!richTextItems,
      #"SYSTEM_SYSRULES_richTextDisplayField"(
        label: ri!label,
        labelPosition: if(a!isNullOrEmpty(ri!label), "COLLAPSED", ri!labelPosition),
        accessibilityText: ri!label,
        instructions: ri!instructions,
        align: ri!align,
        helpTooltip: ri!helpTooltip,
        value: local!richTextItems
      )
    ),
    local!result
  )
)</definition>
