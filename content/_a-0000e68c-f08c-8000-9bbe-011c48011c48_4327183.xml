    <rule>
        <name>IEM_ICO_FORMAT_Date</name>
        <uuid>_a-0000e68c-f08c-8000-9bbe-011c48011c48_4327183</uuid>
        <description>Display date or datetime</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  /*NOTE TO SELF: CHANGE TO TYPES INSTEAD OF TOGGLES */
  local!type: typeof(ri!value),
  local!isVerbose: a!defaultValue(value: ri!isVerbose, default: true),
  local!isShortenedMonth: a!defaultValue(value: ri!isShortenedMonth, default: true),
  local!includeTimezone: a!defaultValue(value: ri!includeTimezone, default: true),
  local!isDateOnly: a!defaultValue(value: ri!isDateOnly, default: false),
  
  if(a!isNullOrEmpty(ri!value),
    a!defaultValue(value: ri!default, default: ri!value),
    a!match(
      value: local!type,
      whenTrue: or(local!type = 7, local!isDateOnly),
      then: text(ri!value, if(local!isVerbose, if(local!isShortenedMonth, "mmm", "mmmm") &amp; " d, yyyy", "m/d/yyyy")),
      whenTrue: local!type = 9,
      then: text(ri!value, if(local!isVerbose, if(local!isShortenedMonth, "mmm", "mmmm") &amp; " d, yyyy", "m/d/yyyy") &amp; " h:mm AM/PM" &amp; if(local!includeTimezone, "z", "")),
      default: a!defaultValue(value: ri!default, default: ri!value)
    )
  )
)</definition>
