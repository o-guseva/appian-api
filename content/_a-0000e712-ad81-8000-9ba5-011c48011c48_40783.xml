    /*DEFAULTS*/
    local!showLabel: a!defaultValue(value: ri!showLabel, default: true),
    local!isValueLabelBefore: a!defaultValue(value: ri!isValueLabelBefore, default: false),
    local!choiceLabels: if(
      a!isNullOrEmpty(ri!choiceLabels),
      if(
        ri!showNA,
        #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60513",
        #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60520"
      ),
      ri!choiceLabels
    ),
    local!choiceValues: if(
      ri!showNA,
      #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60506",
      #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60499"
    ),
    /*CALC*/
    local!value: a!refreshVariable(
      refreshOnReferencedVarChange: true,
      value: 
      a!match(
        value: lower(ri!value),
        /*YES*/
        equals: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60506"[1],
        then: local!choiceValues[1],
        equals: "y",
        then: local!choiceValues[1],
        equals: "yes",
        then: local!choiceValues[1],
        /*NO*/
        equals: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60506"[2],
        then: local!choiceValues[2],
        equals: "n",
        then: local!choiceValues[2],
        equals: "no",
        then: local!choiceValues[2],
        /*N/A*/
        equals: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60506"[3],
        then: local!choiceValues[3],
        equals: "na",
        then: local!choiceValues[3],
        equals: "N/A",
        then: local!choiceValues[3],
        default: ri!value
      )
    ),
    local!valueLabel: 
    a!refreshVariable(
      refreshOnReferencedVarChange: true,
      value: 
      a!match(
        value: local!value,
        whenTrue: local!showLabel = false,
        then: "",
        equals: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60506"[1],
        then: local!choiceLabels[1],
        equals: "true",
        then: local!choiceLabels[1],
        equals: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60506"[2],
        then: local!choiceLabels[2],
        equals: "false",
        then: local!choiceLabels[2],
        equals: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_60506"[3],
        then: local!choiceLabels[3],
        default: local!choiceLabels[2]
      )
    ),
    if(
      ri!isReadOnly,
      #"_a-0000e77d-05a2-8000-9baf-011c48011c48_50461"(
        label: ri!label,
        accessibilityText: ri!accessibilityText,
        instructions: ri!instructions,
        value: {
          if(and(
            local!isValueLabelBefore, 
            a!isNotNullOrEmpty(local!valueLabel)
          ), 
            local!valueLabel &amp; " ", 
            ""
          ),
          /*a!match(*/
            /*value: lower(ri!value),*/
            /*whenTrue: */
            /*contains(*/
              /*{*/
                /*"true",*/
                /*"1",*/
                /*"y",*/
                /*"yes"*/
              /*}, */
              /*fv!value*/
            /*),*/
            /*then: */
            /*a!richTextIcon(*/
              /*icon: "check-square-o",*/
              /*altText: ri!value,*/
              /*caption: ri!helpTooltip,*/
              /*color: "POSITIVE"*/
            /*),*/
            /*whenTrue: contains(*/
              /*{*/
                /*"false",*/
                /*"0",*/
                /*"n",*/
                /*"no",*/
                /*"N/A"*/
              /*}, */
              /*fv!value*/
            /*),*/
            /*then: */
            /*a!richTextIcon(*/
              /*icon: "square-o",*/
              /*altText: ri!value,*/
              /*caption: ri!helpTooltip*/
            /*),*/
            /*whenTrue: contains(*/
              /*{*/
                /*"N/A"*/
              /*}, */
              /*fv!value*/
            /*),*/
            /*then: a!richTextItem(text: "N/A"),*/
            /*default: */
            /*a!richTextIcon(*/
              /*icon: "square-o",*/
              /*altText: ri!value,*/
              /*caption: ri!helpTooltip*/
            /*)*/
          /*),*/
          if(local!value,
            #"SYSTEM_SYSRULES_richTextIcon"(
              icon: "check-circle-o",
              altText: ri!value,
              caption: ri!helpTooltip,
              color: "POSITIVE",
              size: "MEDIUM"
            ),
            #"SYSTEM_SYSRULES_richTextIcon"(
              icon: "times-circle-o",
              altText: ri!value,
              caption: ri!helpTooltip,
              color: "NEGATIVE",
              size: "MEDIUM"
            )
          ),
          if(and(
            local!isValueLabelBefore = false, 
            a!isNotNullOrEmpty(local!valueLabel)
          ), 
            " " &amp; local!valueLabel, ""
          )
        },
        helpTooltip: ri!helpTooltip,
        widthLabel: ri!widthLabel,
        widthValue: ri!widthValue,
        labelPosition: ri!labelPosition,
        isSideBySide: ri!isSideBySide,
        align: ri!align
      ),
      #"SYSTEM_SYSRULES_radioButtonField_v1"(
        label: ri!label,
        labelPosition: ri!labelPosition,
        accessibilityText: a!defaultValue(value: ri!accessibilityText, default: ri!label),
        instructions: ri!instructions,
        helpTooltip: ri!helpTooltip,
        choiceLabels: local!choiceLabels,
        choiceValues: local!choiceValues,
        value: local!value,
        saveInto: { ri!value, { ri!saveInto } },
        required: ri!isRequired,
        requiredMessage: ri!requiredMessage,
        disabled: ri!isDisabled,
        choiceLayout: a!defaultValue(
          value: ri!choiceLayout,
          default: "COMPACT"
        ),
        choiceStyle: a!defaultValue(
          value: ri!choiceStyle,
          default: "STANDARD"
        ),
        validations: ri!validations,
        validationGroup: ri!validationGroup,
        marginAbove: ri!marginAbove,
        marginBelow: a!defaultValue(value: ri!marginBelow, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_191360")
      )
    )
