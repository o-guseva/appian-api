    <rule>
        <name>IEM_ICO_GENERATE_ProcessDisplayName</name>
        <uuid>_a-0000e712-ad81-8000-9ba5-011c48011c48_45844</uuid>
        <description>Use for all process models, generates a standard process display name</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  /*DEFAULTS*/
  local!separatorValueForField: ": ",
  local!separatorValueBetweenFields: "|",
  concat(
    {
      a!defaultValue(value: ri!idLabel, default: "Object ID"),
      local!separatorValueForField,
      a!defaultValue(value: trim(tostring(union(ri!idValue, ri!idValue))), default: "NONE"),
      if(a!isNullOrEmpty(ri!objectTypeId), 
        "",
        {
          local!separatorValueBetweenFields, 
          "Object Type ID",
          local!separatorValueForField,
          ri!objectTypeId
        }
      )
    },
    {
      if(a!isNullOrEmpty(ri!idModuleRefValue), 
        "",
        {
          local!separatorValueBetweenFields, 
          a!defaultValue(value: ri!idModuleRefLabel, default: "Module Ref ID"),
          local!separatorValueForField,
          trim(tostring(union(ri!idModuleRefValue, ri!idModuleRefValue)))
        }
      )
    },
    if(a!isNullOrEmpty(ri!userAction), 
      "", 
      {
        local!separatorValueBetweenFields,
        "UserAction",
        local!separatorValueForField,
        ri!userAction
      }
    ),
    if(a!isNullOrEmpty(ri!additionalDetails), 
      "", 
      {
        local!separatorValueBetweenFields, 
        ri!additionalDetails
      }
    )
  )
)</definition>
