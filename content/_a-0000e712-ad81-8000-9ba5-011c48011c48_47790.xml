  local!dateSigned: a!defaultValue(value: ri!dateSigned, default: today()),
  local!stackWhen: { "PHONE"},
  
  {
    #"_a-0000eb49-2433-8000-af2a-01ef9001ef90_24919"(
      width: {"AUTO", "MINIMIZE"},
      stackWhen: local!stackWhen,
      contents: {
        #"_a-0000e712-ad81-8000-9ba5-011c48011c48_47775"(
          label: a!defaultValue(value: ri!labelSignature, default: "Applicant or Authorized Representative Signature"),
          instructions: local!instructions,
          isRequired: local!isRequired,
          requiredMessage: local!requiredMessage,
          isReadOnly: local!isReadOnly,
          isDisabled: local!isDisabled,
          value: ri!signature,
          saveInto: {
            ri!signature,
            ri!saveInto
          },
          fileName: ri!filename,
          validationGroup: ri!validationGroup,
          helpTooltip: ri!helpTooltip,
          target: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_57202"
        ),
        #"SYSTEM_SYSRULES_richTextDisplayField"(
          label: "Printed Name",
          value: ri!printedName,
          showWhen: #"SYSTEM_SYSRULES_isPageWidth"(pageWidths: local!stackWhen)
        ),
        #"_a-0000e84a-77e4-8000-9bc9-011c48011c48_339430"(
          label: a!defaultValue(value: ri!labelDate, default: "Signed Date"),
          value: local!dateSigned,
          isReadOnly: true
        )
      },
      numColumns: local!numColumns
    ),
    #"SYSTEM_SYSRULES_richTextDisplayField"(
      label: "Printed Name",
      value: ri!printedName,
      showWhen: #"SYSTEM_SYSRULES_isPageWidth"(pageWidths: local!stackWhen) = false
    )
  }
)</definition>
