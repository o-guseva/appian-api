        <definition>if(
  ri!showWhen = false,
  {},
  #"_a-0000e777-b878-8000-9bad-011c48011c48_47417"(
    contents: {
      #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40344"(
        text: ri!header,
        align: "CENTER",
        headingType: #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40408"[5]
      ),
      ri!contentsHeader,
      #"_a-0000e712-ad81-8000-9ba5-011c48011c48_41081"(),
      #"_a-0000e712-ad81-8000-9ba5-011c48011c48_41081"(),
      if(a!defaultValue(value: ri!showHeader, default: true),
        #"SYSTEM_SYSRULES_cardLayout"(
          contents: {
            #"_a-0000e712-ad81-8000-9ba5-011c48011c48_36733"(
              contents: {
                #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40344"(
                  text: a!defaultValue(value: ri!name, default: " "),
                  align: "LEFT",
                  headingType: #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40408"[4]
                ),
                #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40344"(
                  text: text(now(), "mmm dd, yyyy"),
                  align: "RIGHT",
                  headingType: #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40408"[4]
                )
              },
              numColumns: 2,
              stackWhen: "NEVER"
            ),
            #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40344"(
              text: ri!addressLine1,
              align: "LEFT",
              headingType: #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40408"[4],
              showWhen: a!isNotNullOrEmpty(ri!addressLine1)
            ),
            #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40344"(
              text: ri!addressLine2,
              align: "LEFT",
              headingType: #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40408"[4],
              showWhen: a!isNotNullOrEmpty(ri!addressLine2)
            ),
            #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40344"(
              text: ri!city &amp; if(a!isNullOrEmpty(ri!state), "", ", ") &amp; ri!state &amp; " " &amp; ri!zipCode,
              align: "LEFT",
              headingType: #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40408"[4],
              showWhen: 
              and(
                a!isNotNullOrEmpty(ri!city),
                a!isNotNullOrEmpty(ri!state),
                a!isNotNullOrEmpty(ri!zipCode)
              )
            )
          },
          showBorder: false
        ),
        {}
      ),
      #"SYSTEM_SYSRULES_horizontalLine"(),
      if(a!isNullOrEmpty(ri!contents),
        {},
        {
          #"SYSTEM_SYSRULES_cardLayout"(
            contents: ri!contents,
            showBorder: false,
            marginBelow: "STANDARD"
          ),
          #"SYSTEM_SYSRULES_horizontalLine"()
        }
      ),
      #"SYSTEM_SYSRULES_cardLayout"(
        contents: 
        #"_a-0000e712-ad81-8000-9ba5-011c48011c48_47790"(
          printedName: ri!name,
          isReadOnly: ri!isReadOnly,
          saveInto: ri!saveInto,
          signature: ri!signature
        ),
        showBorder: false
      ),
      #"_a-0000e712-ad81-8000-9ba5-011c48011c48_41081"()
    },
    padding: "MORE",
    showBorder: true
  )
)</definition>
