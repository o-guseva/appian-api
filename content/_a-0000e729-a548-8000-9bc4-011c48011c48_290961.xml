    <rule>
        <name>IEM_ICO_GENERATE_CleanName</name>
        <uuid>_a-0000e729-a548-8000-9bc4-011c48011c48_290961</uuid>
        <description>Cleans up a name field with the characters that are valid (letters, numbers, whitespace, and a few select special characters)</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>cleanwith(
  ri!name,
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890 _-.|@'"
)</definition>
        <namedTypedValue>
            <name>name</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
