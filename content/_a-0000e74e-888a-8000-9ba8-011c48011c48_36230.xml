        <definition>a!localVariables(
  /*DEFAULTS*/
  local!marginBelow: a!defaultValue(value: ri!marginBelow, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_191368"),
  local!showBorder: a!defaultValue(value: ri!showBorder, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_191416"),
  local!showShadow: a!defaultValue(value: ri!showShadow, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_191409"),
  local!showFullImage: a!defaultValue(value: ri!showFullImage, default: false),
  local!sizeLogo: a!defaultValue(value: ri!sizeLogo, default: "SMALL_PLUS"),
  local!width:
  if(a!isNullOrEmpty(ri!image),
    a!defaultValue(value: ri!width, default: "AUTO"),
    a!defaultValue(value: ri!width, default: {"AUTO", "MINIMIZE"})
  ),
  local!padding: 
  if(or(a!isNullOrEmpty(ri!image), local!showFullImage),
    a!defaultValue(value: ri!padding, default: "NONE"),
    a!defaultValue(value: ri!padding, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_191392")
  ),
  
  if(ri!showWhen &lt;&gt; false,
    #"SYSTEM_SYSRULES_cardLayout"(
      marginBelow: local!marginBelow,
      padding: local!padding,
      showBorder: local!showBorder,
      showShadow: local!showShadow,
      contents: {
        if(local!showFullImage,
          /*ri!contents,*/
          #"SYSTEM_SYSRULES_billboardLayout_v1"(
            backgroundMedia: 
            #"SYSTEM_SYSRULES_documentImage"(
              document: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_192297"
            ),
            height: "AUTO"
          ),
          #"_a-0000eb49-2433-8000-af2a-01ef9001ef90_24919"(
            alignVertical: "MIDDLE",
            width: local!width,
            contents: {
              if(a!isNullOrEmpty(ri!image),
                {},
                #"SYSTEM_SYSRULES_imageField_v1"(
                  label: "Banner",
                  labelPosition: "COLLAPSED",
                  images: 
                  #"SYSTEM_SYSRULES_documentImage"(
                    document: ri!image,
                    altText: "CMS.iQ"
                  ),
                  size: local!sizeLogo
                )
              ),
              ri!contents
            }
          )
        )
      }
    ),
    {}
  )
)</definition>
