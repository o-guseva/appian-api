        <name>IEM_ICO_CMPT_MilestoneField</name>
        <uuid>_a-0000e74e-888a-8000-9ba8-011c48011c48_36526</uuid>
        <description></description>
        <parentUuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2110934</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(ri!showWhen &lt;&gt; false,
  a!localVariables(
    local!stepId: 
    a!defaultValue(
      value: wherecontains(ri!selectedStep, ri!steps),
      default: 1
    ),
    local!navStyle:
    a!defaultValue(
      value: ri!navStyle,
      default: #"_a-0000e8bf-9ed1-8000-9bd7-011c48011c48_514170"[2]
    ),
    local!orientation:
    a!defaultValue(
      value: ri!orientation,
      default: if(#"SYSTEM_SYSRULES_isNativeMobile"(), "VERTICAL", "HORIZONTAL")
    ),
    local!color:
    a!defaultValue(
      value: ri!color,
      default: #"_a-0000eb3e-868d-8000-af28-01ef9001ef90_14786"
    ),
    #"SYSTEM_SYSRULES_milestoneField"(
      labelPosition: "COLLAPSED",
      steps: ri!steps,
      links: 
      if(local!navStyle = #"_a-0000e8bf-9ed1-8000-9bd7-011c48011c48_514170"[1],
        null,
        #"SYSTEM_SYSRULES_forEach"(
          items: ri!steps,
          expression: 
          if(or(
              local!navStyle = #"_a-0000e8bf-9ed1-8000-9bd7-011c48011c48_514170"[3],
              and(
                local!navStyle = #"_a-0000e8bf-9ed1-8000-9bd7-011c48011c48_514170"[2],
                fv!index &lt;= local!stepId
              )
            ),
            #"SYSTEM_SYSRULES_dynamicLink"(
              saveInto: {
                a!save(ri!selectedStep, fv!item),
                ri!saveInto
              }
            ),
            null
          )
        )
      ),
      active: local!stepId,
      orientation: local!orientation,
      color: local!color,
      marginAbove: ri!marginAbove,
      marginBelow: ri!marginBelow
    )
  ), {}
)</definition>
