        <definition>if(or(
  a!isNullOrEmpty(ri!contents),
    ri!showWhen = false
  ), {},
  #"SYSTEM_SYSRULES_cardLayout"(
    style: ri!style,
    shape: if(ri!isForm, "SQUARED", "SEMI_ROUNDED"),
    tooltip: ri!tooltip,
    padding: a!defaultValue(value: ri!padding, default: if(ri!isForm, "NONE", "LESS")),
    showBorder: a!defaultValue(value: ri!showBorder, default: false),
    decorativeBarPosition: ri!decorativeBarPosition,
    decorativeBarColor: ri!decorativeBarColor,
    showShadow: a!defaultValue(value: ri!showShadow, default: if(ri!isForm, false, true)),
    marginBelow: a!defaultValue(value: ri!marginBelow, default: if(ri!isForm, "NONE", "STANDARD")),
    marginAbove: a!defaultValue(value: ri!marginAbove, default: "NONE"),
    contents: {
      if(and(a!isNullOrEmpty(ri!label), a!isNullOrEmpty(ri!contentsLabel)), {},
        {
          if(a!isNullOrEmpty(ri!contentsHeader),
            if(a!isNullOrEmpty(ri!contentsLabel),
              #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40344"(
                text: ri!label,
                instructions: ri!instructions,
                headingType: a!defaultValue(value: ri!headingType, default: #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40408"[3]),
                icon: ri!headerIcon,
                color: ri!color,
                helpToolTip: ri!headerHelpToolTip,
                marginBelow: "NONE"
              ),
              ri!contentsLabel
            ),
            #"_a-0000eb49-2433-8000-af2a-01ef9001ef90_24919"(
              alignVertical: "MIDDLE",
              width: a!defaultValue(value: ri!headerWidths, default: {"AUTO", split(rept("MINIMIZE;", count(a!defaultValue(value: ri!contentsHeader, default: 1))), ";")}),
              marginBelow: "NONE",
              stackWhen: a!defaultValue(value: ri!stackWhen, default: #"_a-0000e851-089c-8000-9bcb-011c48011c48_358943"),
              contents: {
                if(a!isNullOrEmpty(ri!contentsLabel),
                  #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40344"(
                    text: ri!label,
                    instructions: ri!instructions,
                    headingType: a!defaultValue(value: ri!headingType, default: #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40408"[3]),
                    icon: ri!headerIcon,
                    color: ri!color,
                    colorIcon: ri!colorIcon,
                    helpToolTip: ri!headerHelpToolTip,
                    marginBelow: "NONE"
                  ),
                  ri!contentsLabel
                ),
                ri!contentsHeader
              }
            )
          ),
          if(a!defaultValue(value: ri!showHorizontalLine, default: true),
            #"SYSTEM_SYSRULES_horizontalLine"(marginAbove: "LESS", marginBelow: "LESS"),
            #"_a-0000e712-ad81-8000-9ba5-011c48011c48_41081"()
          )
        }
      ),
      ri!contents
    },
    link: ri!link,
    borderColor: ri!borderColor
  )
)</definition>
