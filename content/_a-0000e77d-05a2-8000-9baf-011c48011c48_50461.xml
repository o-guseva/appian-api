        <definition>if(ri!showWhen &lt;&gt; false,
  if(or(
      contains({"ABOVE", "ADJACENT", "JUSTIFIED", "COLLAPSED"}, ri!labelPosition),
      a!defaultValue(value: ri!isSideBySide, default: false) = false
    ),
    #"SYSTEM_SYSRULES_richTextDisplayField"(
      label: ri!label,
      labelPosition: ri!labelPosition,
      accessibilityText: a!defaultValue(value: ri!accessibilityText, default: ri!label),
      helpTooltip: ri!helpTooltip,
      instructions: ri!instructions,
      tooltip: ri!tooltipLabel,
      align: ri!align,
      value: if(typeof(ri!value) = 3,
        if(
          ri!isTruncated,
          #"_a-0000e68c-f08c-8000-9bbe-011c48011c48_4327043"(
            value: ri!value,
            charLimit: ri!charLimitTruncated,
            wrapInRichTextDisplay: false
          ),
          ri!value
        ),
        ri!value
      ),
      marginAbove: ri!marginAbove,
      marginBelow: a!defaultValue(value: ri!marginBelow, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_191360"),
    ),
    #"SYSTEM_SYSRULES_sideBySideLayout"(
      alignVertical: if(a!isNullOrEmpty(ri!instructions), "MIDDLE", null),
      items: {
        #"SYSTEM_SYSRULES_sideBySideItem"(
          width: a!defaultValue(value: ri!widthLabel, default: "2X"),
          item: 
          #"SYSTEM_SYSRULES_richTextDisplayField"(
            label: ri!label,
            accessibilityText: a!defaultValue(value: ri!accessibilityText, default: ri!label),
            labelPosition: "COLLAPSED",
            helpTooltip: ri!helpTooltip,
            instructions: ri!instructions,
            tooltip: ri!tooltipLabel,
            value: 
            #"SYSTEM_SYSRULES_richTextItem_v1"(
              text: ri!label,
              style: "STRONG"
            )
          )
        ),
        #"SYSTEM_SYSRULES_sideBySideItem"(
          width: a!defaultValue(value: ri!widthValue, default: "1X"),
          item: 
          #"SYSTEM_SYSRULES_richTextDisplayField"(
            labelPosition: "COLLAPSED",
            align: "LEFT",
            tooltip: ri!tooltipValue,
            value: 
            if(ri!isTruncated,
              #"_a-0000e68c-f08c-8000-9bbe-011c48011c48_4327043"(
                value: ri!value,
                charLimit: ri!charLimitTruncated,
                wrapInRichTextDisplay: false
              ),
              touniformstring(ri!value)
            )
          )
        )
      },
      marginAbove: ri!marginAbove,
      marginBelow: a!defaultValue(value: ri!marginBelow, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_191360"),
    )
  ), {}
)</definition>
