        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(ri!showWhen &lt;&gt; false,
  a!localVariables(
    local!msgType: a!defaultValue(value: ri!msgType, default: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[6]),
    local!showIcon: a!defaultValue(value: ri!showIcon, default: true),
    local!optionsSize: {
      "SMALL", 
      "STANDARD", 
      "MEDIUM", 
      "MEDIUM_PLUS", 
      "LARGE", 
      "LARGE_PLUS", 
      "EXTRA_LARGE"
    },
    local!msgTypeCard: 
    displayvalue(
      ri!msgType,
      #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018",
      {
        "INFO",
        "WARN",
        "ERROR",
        "SUCCESS",
        "NONE",
        "NONE"
      },
      "NONE"
    ),
    local!sizeText: a!defaultValue(value: ri!msgSize, default: local!optionsSize[2]),
    local!sizeIcon: tostring(index(local!optionsSize, wherecontains(local!sizeText, local!optionsSize) + 2, local!optionsSize[length(local!optionsSize)])),
    local!showBorder: a!defaultValue(value: ri!showBorder, default: false),
    local!showShadow: a!defaultValue(value: ri!showShadow, default: false),
    local!padding: a!defaultValue(value: ri!padding, default: "STANDARD"),
    local!marginBelow: a!defaultValue(value: ri!marginBelow, default: "LESS"),
    local!decorativeBarPosition: a!defaultValue(value: ri!decorativeBarPosition, default: if(local!msgType = #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[6], "NONE", "START")),
    local!decorativeBarColor: 
    a!match(
      value: ri!msgType,
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[1],
      then: "ACCENT",
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[2],
      then: #"_a-0000e978-3940-8000-9be9-011c48011c48_685743",
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[3],
      then: "NEGATIVE",
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[4],
      then: "POSITIVE",
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[5],
      then: "ACCENT",
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[6],
      then: "",
      default: ""
    ),
    local!icon:
    a!match(
      value: ri!msgType,
      equals: local!showIcon = false,
      then: {},
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[1],
      then: 
      #"SYSTEM_SYSRULES_richTextIcon"(
        icon: a!defaultValue(value: ri!icon, default: "info-circle"),
        altText: "Info!",
        color: "ACCENT",
        size: local!sizeIcon
      ),
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[2],
      then: 
      #"SYSTEM_SYSRULES_richTextIcon"(
        icon: a!defaultValue(value: ri!icon, default: "exclamation-triangle"),
        altText: "Warn!",
        color: #"_a-0000e978-3940-8000-9be9-011c48011c48_685743",
        size: local!sizeIcon
      ),
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[3],
      then: 
      #"SYSTEM_SYSRULES_richTextIcon"(
        icon: a!defaultValue(value: ri!icon, default: "exclamation-circle"),
        altText: "Error!",
        color: "NEGATIVE",
        size: local!sizeIcon
      ),
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[4],
      then: 
      #"SYSTEM_SYSRULES_richTextIcon"(
        icon: a!defaultValue(value: ri!icon, default: "check-circle"),
        altText: "Success!",
        color: "POSITIVE",
        size: local!sizeIcon
      ),
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[5],
      then: 
      #"SYSTEM_SYSRULES_richTextIcon"(
        icon: a!defaultValue(value: ri!icon, default: "info-circle"),
        altText: "Plain Highlight!",
        color: "ACCENT",
        size: local!sizeIcon
      ),
      equals: #"_a-0000e7b8-e7e1-8000-9bb9-011c48011c48_149018"[6],
      then: 
      #"SYSTEM_SYSRULES_richTextIcon"(
        icon: a!defaultValue(value: ri!icon, default: "info"),
        altText: "Plain!",
        color: "ACCENT",
        size: local!sizeIcon
      ),
      default: 
      #"SYSTEM_SYSRULES_richTextIcon"(
        icon: a!defaultValue(value: ri!icon, default: "info"),
        altText: "Plain!",
        color: "ACCENT",
        size: local!sizeIcon
      )
    ),
    #"SYSTEM_SYSRULES_cardLayout"(
      decorativeBarColor: local!decorativeBarColor,
      decorativeBarPosition: local!decorativeBarPosition,
      contents: 
      #"_a-0000e712-ad81-8000-9ba5-011c48011c48_36733"(
        width: ri!widths,
        contents: {
          #"SYSTEM_SYSRULES_sideBySideLayout"(
            items: {
              #"SYSTEM_SYSRULES_sideBySideItem"(
                item: 
                #"SYSTEM_SYSRULES_richTextDisplayField"(
                  labelPosition: "COLLAPSED",
                  value: local!icon,
                  preventWrapping: true
                ),
                width: "MINIMIZE",
                showWhen: local!showIcon
              ),
              #"SYSTEM_SYSRULES_sideBySideItem"(
                item: 
                #"SYSTEM_SYSRULES_richTextDisplayField"(
                  labelPosition: "COLLAPSED",
                  value: {
                    #"SYSTEM_SYSRULES_richTextItem_v1"(
                      text: ri!msg,
                      size: local!sizeText,
                      style: "STRONG"
                    ),
                    if(a!isNullOrEmpty(ri!msgSecondary),
                      {},
                      {
                        char(10),
                        ri!msgSecondary
                      }
                    )
                  }
                ),
                width: "AUTO"
              )
            },
            alignVertical: "MIDDLE",
            spacing: "SPARSE",
            marginBelow: "NONE"
          ),
          ri!contents
        },
        numColumns: a!defaultValue(value: ri!numColumns, default: 1),
        marginBelow: "NONE"
      ),
      padding: local!padding,
      style: local!msgTypeCard,
      marginBelow: local!marginBelow,
      showBorder: local!showBorder,
      showShadow: local!showShadow,
      link: ri!link
    )
  ), {}
)</definition>
