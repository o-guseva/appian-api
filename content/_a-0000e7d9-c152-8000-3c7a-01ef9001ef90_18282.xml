<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_59606</versionUuid>
    <rule>
        <name>IEM_ICO_GENERATE_FromJson</name>
        <uuid>_a-0000e7d9-c152-8000-3c7a-01ef9001ef90_18282</uuid>
        <description>Converts a JSON string to a dictionary. If the string is not JSON, returns an empty dictionary. &lt;br&gt;
NEEDS TO BE REFACTORED</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!defaultRv: cast('type!{http://www.appian.com/ae/types/2009}Dictionary',{}),
  local!tryFromJson: if(
    isnull(ri!i_jsonString),
    local!defaultRv,
    try(#"SYSTEM_SYSRULES_fromJson_v1"(ri!i_jsonString), { fromJsonError: true })
  ),
  if(
    index(local!tryFromJson,"fromJsonError",false),
    try(
      eval(ri!i_jsonString),
      local!defaultRv
    ),
    local!tryFromJson
  )
)</definition>
        <namedTypedValue>
            <name>i_jsonString</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
