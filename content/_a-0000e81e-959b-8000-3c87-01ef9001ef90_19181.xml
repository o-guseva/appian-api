    <versionUuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_56745</versionUuid>
    <rule>
        <name>IEM_ICO_GENERATE_ToJson</name>
        <uuid>_a-0000e81e-959b-8000-3c87-01ef9001ef90_19181</uuid>
        <description>Converts input to JSON</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(isnull(ri!i_value),"null",
if(length(ri!i_value) = 0, "[]",
if(length(ri!i_value) = 1, try(#"SYSTEM_SYSRULES_toJson_v1"(ri!i_value),if(typeof(ri!i_value)='type!{http://www.appian.com/ae/types/2009}Text',concat("""",ri!i_value,""""),tostring(ri!i_value))),
#"SYSTEM_SYSRULES_toJson_v1"(ri!i_value))))</definition>
        <namedTypedValue>
            <name>i_value</name>
            <type>
                <name>Variant</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
