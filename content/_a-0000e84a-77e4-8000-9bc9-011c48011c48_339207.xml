        <definition>a!localVariables(
  /*DEFAULTS*/
  local!height: a!defaultValue(value: ri!height, default: "TALL"),
  local!charLimit: a!defaultValue(value: ri!charLimit, default: 4000),
  local!showCharacterCount: a!defaultValue(value: ri!showCharacterCount, default: true),
  local!accessibilityText: a!defaultValue(value: ri!accessibilityText, default: ri!label),
  
  if(
    ri!isReadOnly,
    #"_a-0000e77d-05a2-8000-9baf-011c48011c48_50461"(
      label: ri!label,
      instructions: ri!instructions,
      value: ri!value,
      isTruncated: ri!isTruncated,
