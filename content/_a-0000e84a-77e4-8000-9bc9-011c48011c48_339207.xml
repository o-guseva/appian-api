      helpTooltip: ri!helpTooltip,
      widthLabel: ri!widthLabel,
      widthValue: ri!widthValue,
      labelPosition: ri!labelPosition,
      isSideBySide: ri!isSideBySide,
      align: ri!align,
      marginBelow: ri!marginBelow,
      marginAbove: ri!marginAbove,
      accessibilityText: ri!accessibilityText
    ),
    #"SYSTEM_SYSRULES_paragraphField"(
      label: ri!label,
      labelPosition: ri!labelPosition, 
      instructions: ri!instructions,
      helpTooltip: ri!helpTooltip,
      placeholder: a!defaultValue(
        value: ri!placeholder,
        default: #"d5b22347-921f-47c4-a4df-d1a507c3f76b"(label: ri!label)
      ),
      value: ri!value,
      saveInto: {
        if(ri!disableAutoSave, {}, ri!value),
        ri!saveInto
      },
      refreshAfter: ri!refreshAfter,
      characterLimit: local!charLimit,
      showCharacterCount: local!showCharacterCount,
      height: local!height,
      showWhen: ri!showWhen,
      required: ri!isRequired,
      requiredMessage: ri!requiredMessage,
      readOnly: ri!isReadOnly,
      disabled: ri!isDisabled,
      validations: ri!validations,
      validationGroup: ri!validationGroup,
      marginAbove: ri!marginAbove,
      marginBelow: ri!marginBelow,
      accessibilityText: local!accessibilityText
    )
  )
)</definition>
