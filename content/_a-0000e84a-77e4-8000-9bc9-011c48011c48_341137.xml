    <interface>
        <name>IEM_ICO_CMPT_DollarField</name>
        <uuid>_a-0000e84a-77e4-8000-9bc9-011c48011c48_341137</uuid>
        <description>Dollar field (similar to IEM_dollarField) with saveInto added.</description>
        <parentUuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2110934</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
