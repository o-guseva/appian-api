            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  ri!showWhen &lt;&gt; false,
  if(
    ri!isReadOnly,
    #"_a-0000e77d-05a2-8000-9baf-011c48011c48_50461"(
      label: ri!label,
      value: #"_a-0000e45b-3a6f-8000-9ba6-011c48011c48_3361909"(amount: ri!value, showCents: ri!showCents, defaultValue: ri!defaultValue),
      widthLabel: ri!widthLabel,
      widthValue: ri!widthValue,
      labelPosition: 
      a!defaultValue(
        value: ri!labelPosition,
        default: #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40791"
      ),
      isSideBySide: ri!isSideBySide,
      align: ri!align
    ),
    #"SYSTEM_SYSRULES_textField"(
      label: ri!label,
      labelPosition: ri!labelPosition,
      helpTooltip: ri!helpTooltip,
      placeholder: if(a!defaultValue(value: ri!showCents, default: true), "$0.00", "$0"),
      value: #"_a-0000e45b-3a6f-8000-9ba6-011c48011c48_3361909"(amount: ri!value, showCents: ri!showCents, defaultValue: ri!defaultValue),
      saveInto: {
        a!save(ri!value, todecimal(save!value)),
        ri!saveInto
      },
      required: ri!isRequired,
      readOnly: ri!isReadOnly,
      disabled: ri!isDisabled,
      requiredMessage: ri!requiredMessage,
      validations: {
        if(ri!value = a!defaultValue(value: ri!defaultValue, default: ""),
        "Enter a value to continue",
        if(
          a!defaultValue(value: ri!allowNegativeAmount, default: false) = true,
          null,
          #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_57575"(value: ri!value)
        )
        ),
        ri!validations
      },
      validationGroup: ri!validationGroup,
      align: ri!align
    )
  ),
  {}
)</definition>
