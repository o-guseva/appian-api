    <interface>
        <name>IEM_ICO_CMPT_PagingField</name>
        <uuid>_a-0000e8bf-9ed1-8000-9bd7-011c48011c48_481535</uuid>
        <description>Grid Paging compatible with editable grids</description>
        <parentUuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2110934</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(ri!showWhen &lt;&gt; false,
  a!localVariables(
    /*DEFAULTS*/
    local!colorActive: a!defaultValue(value: ri!colorActive, default: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_59831"),
    local!colorDisabled: a!defaultValue(value: ri!colorDisabled, default: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_62912"),
    local!align: a!defaultValue(value: ri!align, default: "RIGHT"),
    
    #"SYSTEM_SYSRULES_richTextDisplayField"(
      labelPosition: "COLLAPSED",
      preventWrapping: true,
      value: {
        #"SYSTEM_SYSRULES_richTextIcon"(
          icon: "chevron-left",
          link: 
          #"SYSTEM_SYSRULES_dynamicLink"(
            saveInto: {
              a!save(
                ri!pagingInfo,
                #"SYSTEM_SYSRULES_pagingInfo"(
                  startIndex: ri!pagingInfo.startIndex - ri!pagingInfo.batchSize,
                  batchSize: ri!pagingInfo.batchSize,
                  sort: ri!pagingInfo.sort
                )
              ),
              ri!saveInto
            },
            showWhen: ri!pagingInfo.startIndex &gt; 1
          ),
          linkStyle: "STANDALONE",
          size: "MEDIUM",
          color: if(ri!pagingInfo.startIndex &gt; 1, local!colorActive, local!colorDisabled)
        ),
        " ",
        #"SYSTEM_SYSRULES_richTextItem_v1"(
          text: {
            property(ri!pagingInfo, "startIndex", 0),
            " - ",
            if(ri!totalCount &lt; property(ri!pagingInfo, "startIndex", 0) + property(ri!pagingInfo, "batchSize", 0) - 1,
              ri!totalCount,
              property(ri!pagingInfo, "startIndex", 0) + property(ri!pagingInfo, "batchSize", 0) - 1
            )
          },
          style: "STRONG"
        ),
        " of ", 
        ri!totalCount,
        " ",
        #"SYSTEM_SYSRULES_richTextIcon"(
          icon: "chevron-right",
          link: 
          #"SYSTEM_SYSRULES_dynamicLink"(
            saveInto: {
              a!save(
                ri!pagingInfo,
                #"SYSTEM_SYSRULES_pagingInfo"(
                  startIndex: ri!pagingInfo.startIndex + ri!pagingInfo.batchSize,
                  batchSize: ri!pagingInfo.batchSize,
                  sort: ri!pagingInfo.sort
                )
              ),
              ri!saveInto
            },
            showWhen: ri!pagingInfo.startIndex &lt; ri!totalCount - ri!pagingInfo.batchSize
          ),
          linkStyle: "STANDALONE",
          size: "MEDIUM",
          color: if(ri!pagingInfo.startIndex &lt; ri!totalCount - ri!pagingInfo.batchSize, local!colorActive, local!colorDisabled)
        )
      },
      align: local!align
    )
  ),
  {}
)</definition>
