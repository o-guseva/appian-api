    <versionUuid>_a-0000ec66-328d-8000-af46-01ef9001ef90_114550</versionUuid>
    <rule>
        <name>IEM_ICO_GET_EnvName</name>
        <uuid>_a-0000e90a-c7d1-8000-9be0-011c48011c48_582686</uuid>
        <description>gets the environment name based on the characters before the first "." in the URL</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!taskUrl: a!urlForTask(taskIds: -1, returnTaskPathOnly: false),
  tostring(extract(local!taskUrl, "//", ".")[1])
)</definition>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
