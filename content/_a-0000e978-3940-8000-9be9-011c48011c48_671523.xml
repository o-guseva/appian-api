    <interface>
        <name>IEM_ICO_LAYOUT_HomepageLayout</name>
        <uuid>_a-0000e978-3940-8000-9be9-011c48011c48_671523</uuid>
        <description>Default layout for a homepage &lt;br&gt;
Works well with card-style action buttons, but use a buttonLayout() w/ a process model for the best results</description>
        <parentUuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2110934</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(ri!showWhen &lt;&gt; false,
  a!localVariables(
    local!stackWhen: a!defaultValue(value: ri!stackWhen, default: #"_a-0000e851-089c-8000-9bcb-011c48011c48_358943"),
    local!spacing: a!defaultValue(value: ri!spacing, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_192016"),
    local!maxNumButtons: 5,
    local!numButtons: count(ri!contentsButtons),
    {
      ri!contentsBanner,
      /*ACTION BUTTONS*/
      #"_a-0000e712-ad81-8000-9ba5-011c48011c48_36733"(
        numColumns: local!maxNumButtons,
        contents: 
        if(a!isNullOrEmpty(ri!contentsButtons),
          {},
          {
            if(local!numButtons &gt;= local!maxNumButtons, 
              {},
              #"SYSTEM_SYSRULES_forEach"(
                items: local!maxNumButtons - local!numButtons, 
                expression: #"SYSTEM_SYSRULES_richTextDisplayField"()
              )
            ),
            ri!contentsButtons
          }
        )
      ),
      /*BODY*/
      #"SYSTEM_SYSRULES_columnsLayout"(
        columns: {
          /*NAV BAR*/
          #"SYSTEM_SYSRULES_columnLayout"(
            contents: ri!contentsNav,
            width: "NARROW"
          ),
          /*MAIN GRID*/
          #"SYSTEM_SYSRULES_columnLayout"(
            contents: ri!contentsBody
          )
        },
        stackWhen: local!stackWhen,
        spacing: local!spacing,
        marginBelow: ri!marginBelow,
        marginAbove: ri!marginAbove,
        alignVertical: ri!alignVertical
      )
    }
  ), {}
)</definition>
