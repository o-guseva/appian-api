        backgroundColor: #"_a-0000e978-3940-8000-9be9-011c48011c48_685777",
        textColor: "#115EBB"
      }
    ),
    #"SYSTEM_SYSRULES_tagField"(
      label: ri!label,
      labelPosition: local!labelPosition,
      helpTooltip: ri!helpTooltip,
      tags: 
      #"SYSTEM_SYSRULES_forEach"(
        items: ri!value,
        expression: 
        #"SYSTEM_SYSRULES_tagItem_v1"(
          text: fv!item,
          backgroundColor: local!tagTuple.backgroundColor,
          textColor: local!tagTuple.textColor,
          link: ri!link,
          tooltip: ri!helpTooltipTags
