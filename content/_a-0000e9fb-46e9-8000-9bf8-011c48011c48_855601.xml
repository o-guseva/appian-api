    <rule>
        <name>IEM_ICO_FORMAT_Name</name>
        <uuid>_a-0000e9fb-46e9-8000-9bf8-011c48011c48_855601</uuid>
        <description>Format a user's name</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>trim(
  concat(
    {
      ri!prefix, " ",
      ri!firstName, " ",
      ri!middleName, " ",
      ri!lastName, " ",
      ri!suffix, " ",
      if(a!isNullOrEmpty(ri!username),
        "",
        {char(10), "(", ri!username, ")"}
      )
    }
  )
)</definition>
