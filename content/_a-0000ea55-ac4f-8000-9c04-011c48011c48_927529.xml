    /*DEFAULTS*/
    local!isReadOnly: a!defaultValue(value: ri!isReadOnly, default: false),
    local!label: a!defaultValue(value: ri!label, default: "Date"),
    local!labelStart: if(local!isReadOnly, ri!label &amp; " Timeframe",  ri!label &amp; " between"),
    local!labelEnd: if(local!isReadOnly, "-", "To"),
    
