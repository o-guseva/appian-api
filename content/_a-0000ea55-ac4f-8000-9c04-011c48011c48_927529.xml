            labelPosition: ri!labelPosition,
            instructions: ri!instructionsFrom,
            accessibilityText: ri!accessibilityText,
            helpTooltip: ri!helpTooltipFrom,
            widthLabel: ri!widthLabel,
            widthValue: ri!widthValue,
            marginAbove: ri!marginAbove,
            marginBelow: ri!marginBelow,
            isSideBySide: ri!isSideBySide,
            align: ri!align,
            isReadOnly: ri!isReadOnly,
            isRequired: ri!isRequired,
            isDisabled: ri!isDisabled,
            value: ri!valueFrom,
            saveInto: { 
              ri!valueFrom, 
              ri!saveInto 
            },
            validationGroup: ri!validationGroup
          )
        ),
        #"SYSTEM_SYSRULES_sideBySideItem"(
          width: "MINIMIZE",
          item: 
          #"_a-0000e84a-77e4-8000-9bc9-011c48011c48_339430"(
            label: local!labelEnd,
            labelPosition: ri!labelPosition,
            instructions: ri!instructionsTo,
            accessibilityText: ri!accessibilityText,
            helpTooltip: ri!helpTooltipTo,
            widthLabel: ri!widthLabel,
            widthValue: ri!widthValue,
            marginAbove: ri!marginAbove,
            marginBelow: ri!marginBelow,
            isSideBySide: ri!isSideBySide,
            align: ri!align,
            isReadOnly: ri!isReadOnly,
            isRequired: ri!isRequired,
            isDisabled: ri!isDisabled,
            value: ri!valueTo,
            saveInto: { 
              ri!valueTo, 
              ri!saveInto 
            },
            validationGroup: ri!validationGroup
          )
        )
      }
    )
  ),
  {}
)</definition>
