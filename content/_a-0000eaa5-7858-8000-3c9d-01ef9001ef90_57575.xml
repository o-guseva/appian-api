<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_58891</versionUuid>
    <rule>
        <name>IEM_ICO_VALIDATE_NonNegativeValue</name>
        <uuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_57575</uuid>
        <description>Throws exception if value is non-negative</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(a!isNullOrEmpty(ri!value),
  "",
  if(
    tointeger(ri!value) &lt; 0.00,
    "Value cannot be negative",
    ""
  )
)</definition>
        <namedTypedValue>
            <name>value</name>
            <type>
                <name>double</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
    <roleMap public="true">
