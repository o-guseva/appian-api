    <rule>
        <name>IEM_ICO_EXTRACT_DocumentName</name>
        <uuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_59189</uuid>
        <description>Fetches document name w/ or w/o extension</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(a!isNullOrEmpty(ri!document),
  "",
  a!localVariables(
    local!filename: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_59153"(document: ri!document, property: "name"),
    local!extension: 
    if(ri!includeExtension = true,
      "." &amp; #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_59153"(document: ri!document, property: "extension"),
      ""
    ),
    local!size: 
    if(ri!includeSize = true,
      " (" &amp; #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_59153"(document: ri!document, property: "size") / 1000 &amp; " kb)",
      ""
    ),
    local!filename 
    &amp; if(ri!includeExtension = true,
      local!extension,
      ""
    )
    &amp; if(ri!includeSize = true,
      local!size,
      ""
    )
  )
)</definition>
        <namedTypedValue>
            <name>document</name>
            <type>
                <name>CollaborationDocument</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
