        <name>IEM_ICO_LAYOUT_BackgroundLayout</name>
        <uuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_63904</uuid>
        <description>Template background layout to maintain site uniformity</description>
        <parentUuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2110934</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(ri!showWhen &lt;&gt; false,
  a!localVariables(
    local!isReadOnly: a!defaultValue(value: ri!isReadOnly, default: false),
    local!contentsWidth: a!defaultValue(value: ri!contentsWidth, default: "FULL"),
    local!backgroundColor: a!defaultValue(value: ri!backgroundColor, default: #"_a-0000eb3e-868d-8000-af28-01ef9001ef90_15581"),
    if(local!isReadOnly,
      #"SYSTEM_SYSRULES_headerContentLayout"(
        header: ri!header,
        contents: ri!contents,
        isHeaderFixed: ri!isHeaderFixed,
        contentsPadding: a!defaultValue(value: ri!contentsPadding, default: "LESS"),
        backgroundColor: local!backgroundColor
      ), 
      #"SYSTEM_SYSRULES_formLayout_v2"(
        titleBar: ri!titleBar,
        isTitleBarFixed: ri!isHeaderFixed,
        showTitleBarDivider: ri!showTitleBarDivider,
        contents: ri!contents,
        contentsWidth: local!contentsWidth,
        buttons: ri!buttons,
        focusOnFirstInput: ri!focusOnFirstInput,
        isButtonFooterFixed: ri!isButtonFooterFixed,
        showButtonDivider: ri!showButtonDivider,
        validations: ri!validations,
        validationGroup: ri!validationGroup
      )
    )
  ), {}
)</definition>
