    <rule>
        <name>IEM_ICO_CALC_Sum</name>
        <uuid>_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_65478</uuid>
        <description>Null-safe sum</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>sum(
  #"SYSTEM_SYSRULES_forEach"(
    items: ri!values,
    expression: a!defaultValue(value: todecimal(fv!item), default: 0.00)
  )
)</definition>
        <namedTypedValue>
            <name>values</name>
            <type>
                <name>Decimal?list</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
