            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(ri!showWhen &lt;&gt; false,
  a!localVariables(
    local!isReadOnly: a!defaultValue(value: ri!isReadOnly, default: false),
    if(local!isReadOnly,
      #"_a-0000e77d-05a2-8000-9baf-011c48011c48_50461"(
        label: ri!label,
        labelPosition: a!defaultValue(value: ri!labelPosition, default: "ABOVE"),
        instructions: ri!instructions,
        align: ri!align,
        helpTooltip: ri!helpTooltip,
        value: 
        #"_a-0000e258-a92d-8000-9ba2-011c48011c48_2112303"(
          value: ri!value,
          isVerbose: ri!isVerbose,
          isShortenedMonth: true
        )
      ),
      #"SYSTEM_SYSRULES_dateTimeField"(
        label: ri!label,
        instructions: ri!instructions,
        required: ri!required,
        readOnly: local!isReadOnly,
        disabled: ri!disabled,
        value: ri!value,
        saveInto: { 
          ri!value, 
          ri!saveInto 
        },
        labelPosition: ri!labelPosition,
        helpTooltip: ri!helpTooltip,
        validationGroup: ri!validationGroup,
        marginAbove: ri!marginAbove,
        marginBelow: ri!marginBelow
      )
    )
  ),
  {}
)</definition>
