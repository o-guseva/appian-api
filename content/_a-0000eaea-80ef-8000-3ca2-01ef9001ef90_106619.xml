        <uuid>_a-0000eaea-80ef-8000-3ca2-01ef9001ef90_106619</uuid>
        <description>Reusable field to allow date selection or show a date time in read only.</description>
        <parentUuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2110934</parentUuid>
        <visibility>
            <advertise>false</advertise>
