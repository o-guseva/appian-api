    <interface>
        <name>IEM_ICO_CMPT_PhoneNumberField</name>
        <uuid>_a-0000eaea-80ef-8000-3ca2-01ef9001ef90_106674</uuid>
        <description>Format the user's input as a telephone number in the US and save the formatted value, not the user's input</description>
        <parentUuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2110934</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  ri!showWhen &lt;&gt; false, 
  if(
    ri!isReadOnly,
    #"_a-0000e77d-05a2-8000-9baf-011c48011c48_50461"(
      label: ri!label,
      labelPosition: ri!labelPosition,
      value: 
      if(#"_a-0000e7e2-2f37-8000-9bbf-011c48011c48_226419"(value: ri!value),
        #"SYSTEM_SYSRULES_richTextItem_v1"(
          text: #"_a-0000e1e0-fd1b-8000-9ba2-011c48011c48_1966031"(
            phoneNumber: ri!value
          ),
          link: 
          if(a!defaultValue(value: ri!enableUriLink, default: true),
            #"SYSTEM_SYSRULES_safeLink"(
              label: "Open in telephone application",
              uri: "tel:" &amp; ri!value
            ), {}
          )
        ),
        ri!value
      ),
      widthLabel: ri!widthLabel,
      widthValue: ri!widthValue,
      isSideBySide: ri!isSideBySide
    ),
    #"SYSTEM_SYSRULES_textField"(
      label: ri!label,
      labelPosition: ri!labelPosition,
      placeholder: a!defaultValue(value: ri!placeholder, default: "E.g. (123) 456-7890"),
      required: ri!required,
      readOnly: ri!isReadOnly,
      disabled: ri!isDisabled,
      requiredMessage: ri!requiredMessage,
      instructions: ri!instructions,
      value: #"_a-0000e1e0-fd1b-8000-9ba2-011c48011c48_1966031"(phoneNumber: ri!value),
      saveInto: {
        a!save(
          ri!value,
          cleanwith(save!value, #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_58241")
        ),
        a!save(
          ri!saveInto,
          cleanwith(save!value, #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_58241")
        )
      },
      validations: ri!validations,
      validationGroup: ri!validationGroup
    )
  ),
  {}
)
</definition>
