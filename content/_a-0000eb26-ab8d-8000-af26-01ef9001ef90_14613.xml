        <definition>#"SYSTEM_SYSRULES_richTextDisplayField"(
  label: "Remove " &amp; ri!index,
  labelPosition: "COLLAPSED",
  align: "CENTER",
  value: 
  if(ri!isDisabled,
    #"SYSTEM_SYSRULES_richTextIcon"(
      icon: "TIMES",
      caption: "DISABLED: Remove Row #" &amp; ri!index,
      color: "SECONDARY",
      linkStyle: "STANDALONE",
      link: 
      if(ri!isDisabled, 
        null,
        #"SYSTEM_SYSRULES_dynamicLink"(
          saveInto: a!save(ri!array, remove(ri!array, ri!index))
        )
      )
    ),
    #"SYSTEM_SYSRULES_richTextIcon"(
      icon: "TIMES",
      caption: "Remove Row #" &amp; ri!index,
      color: "NEGATIVE",
      linkStyle: "STANDALONE",
      link:
      #"SYSTEM_SYSRULES_dynamicLink"(
        saveInto: a!save(ri!array, remove(ri!array, ri!index))
      )
    )
  )
)</definition>
