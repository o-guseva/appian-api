    <interface>
        <name>IEM_ICO_LAYOUT_SideBySideLayout</name>
        <uuid>_a-0000eb49-2433-8000-af2a-01ef9001ef90_24919</uuid>
        <description>Automatically resize and display contents based on provided number of columns</description>
        <parentUuid>_a-0000e258-a92d-8000-9ba2-011c48011c48_2110934</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(or(
    a!isNullOrEmpty(ri!contents),
    ri!showWhen = false
  ), {},
  a!localVariables(
    local!numContents: count(ri!contents),
    local!numWidths: count(ri!width),
    /*Some math, defaults and null handling*/
    local!isNumColumnsEmpty:
    or(
      isnull(ri!numColumns),
      ri!numColumns = 0
    ),
    local!numColumns:
    if(local!isNumColumnsEmpty, 
      local!numContents,
      ri!numColumns
    ),
    local!numRows: 
    if(local!isNumColumnsEmpty,  
    1,
    ceiling(local!numContents / ri!numColumns, 1)
    ),
    /*Generate placeholders*/
    local!enumeratedColumns: enumerate(local!numColumns),
    local!enumeratedRows: enumerate(local!numRows),
    
    local!applyPlaceholders: a!defaultValue(value: ri!applyPlaceholders, default: true),
    local!enumeratedWidths:
    if(a!isNullOrEmpty(ri!width),
      null,
      if(count(ri!width) = 1,
        rdrop(split(rept(ri!width[1] &amp; ";", local!numColumns * (local!enumeratedRows + 1)), ";"), 1),
        append(ri!width, rdrop(split(rept(ri!width[count(ri!width)] &amp; ";", local!numContents - local!numWidths), ";"), 1))
      )
    ),
    #"SYSTEM_SYSRULES_forEach"(
      items: local!enumeratedRows,
      expression: 
      #"SYSTEM_SYSRULES_sideBySideLayout"(
        alignVertical: ri!alignVertical,
        spacing: ri!spacing,
        marginAbove: ri!marginAbove,
        marginBelow: ri!marginBelow,
        stackWhen: a!defaultValue(value: ri!stackWhen, default: #"_a-0000e851-089c-8000-9bcb-011c48011c48_358943"),
        items: 
        a!localVariables(
          local!indexRow: fv!item,
          /*Account for columns, and add empty columns if applicable*/
          #"SYSTEM_SYSRULES_forEach"(
            items: local!enumeratedColumns,
            expression: 
            a!localVariables(
              local!indexColumn: (local!indexRow * local!numColumns) + fv!index,
              if(and(
                  ri!applyPlaceholders = false,
                  local!indexColumn &gt; local!numContents
                ),
                {},
                if(local!indexColumn &gt; local!numContents,
                  if(local!applyPlaceholders,
                    #"SYSTEM_SYSRULES_sideBySideItem"(
                      width: index(local!enumeratedWidths, fv!index, null)
                    ),
                    null
                  ),
                  #"SYSTEM_SYSRULES_sideBySideItem"(
                    item: index({ri!contents}, local!indexColumn, {}),
                    width: index(local!enumeratedWidths, fv!index, null)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)</definition>
