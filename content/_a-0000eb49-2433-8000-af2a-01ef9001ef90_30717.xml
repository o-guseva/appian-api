    <rule>
        <name>IEM_ICO_GENERATE_OrderBy</name>
        <uuid>_a-0000eb49-2433-8000-af2a-01ef9001ef90_30717</uuid>
        <description></description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(any(
    a!isNullOrEmpty(_),
    {
      ri!currentIndex,
      ri!data
    }
  ),
  0,
  a!localVariables(
    /*DEFAULTS*/
    local!currentData: index(ri!data, ri!currentIndex, ri!data),
    local!dataTemplate: remove(ri!data, ri!currentIndex),
    local!incrementStep: a!defaultValue(value: ri!incrementStep, default: 1),
    local!orderByMax: count(ri!data),
    local!orderByMin: 1,
    
    
    /*CALC*/
    local!newOrderBy: 
    if(ri!isIncrementHigher,
      ri!currentIndex + local!incrementStep,
      ri!currentIndex - local!incrementStep
    ),
    local!newOrderByBounded: 
    if(ri!isIncrementHigher, 
      if(local!newOrderBy &gt; local!orderByMax, 
        local!orderByMax,
        local!newOrderBy
      ),
      if(local!newOrderBy &lt; local!orderByMin, 
        local!orderByMin,
        local!newOrderBy
      )
    ),
    local!dataLowerThanNewOrderBy: 
    if(local!newOrderByBounded = local!orderByMin, 
      {},
      rdrop(local!dataTemplate, local!orderByMax - local!newOrderByBounded)
    ),
    local!dataHigherThanNewOrderBy: 
    if(local!newOrderByBounded = local!orderByMin,
      local!dataTemplate,
      ldrop(local!dataTemplate, local!newOrderByBounded)
    ),
    /*AGGREGATE*/
    local!newData: 
    reject(a!isNullOrEmpty(_), append(
      append(local!dataLowerThanNewOrderBy, local!currentData),
      local!dataHigherThanNewOrderBy
    )),
    #"SYSTEM_SYSRULES_forEach"(
      items: local!newData,
      expression: 
      #"urn:appian:function:v1:a:update"(
        data: fv!item,
        index: "orderBy",
        value: fv!index
      )
    )
  )
)</definition>
