        <definition>a!localVariables(
  /*DEFAULTS*/
  local!isUser: isusernametaken(ri!user),
  local!isAnonymous: a!defaultValue(value: ri!user, default: "") = "Anonymous",
  local!labelPosition: a!defaultValue(value: ri!labelPosition, default: "COLLAPSED"),
  local!includeDateTime: a!isNotNullOrEmpty(ri!dateTime),
  local!isVerboseDateTime: a!defaultValue(value: ri!isVerboseDateTime, default: true),
  local!isUserOnTop: a!defaultValue(value: ri!isUserOnTop, default: true),
  #"SYSTEM_SYSRULES_richTextDisplayField"(
    label: ri!label,
    labelPosition: local!labelPosition,
    tooltip: ri!tooltip,
    /*marginAbove: "STANDARD",*/
    marginBelow: "NONE",
    align: ri!align,
    value: {
      if(and(
          local!isUserOnTop = false,
          local!includeDateTime = true
        ),
        {
          #"_a-0000e68c-f08c-8000-9bbe-011c48011c48_4327183"(value: ri!dateTime, isVerbose: local!isVerboseDateTime, includeTimezone: ri!includeTimezone, isShortenedMonth: ri!isShortenedMonth, isDateOnly: ri!isDateOnly),
          char(10)
        },
        {}
      ),
      if(and(local!isUser, local!isAnonymous = false),
        {
          #"SYSTEM_SYSRULES_richTextImage"(
            image: #"SYSTEM_SYSRULES_userImage"(user: ri!user)
          ),
          #"SYSTEM_SYSRULES_richTextItem_v1"(
            text: #"_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2357147"(user: ri!user),
            link: #"_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2357147"(user: ri!user, isUserRecordLink: true)
          )
        },
        {
          #"SYSTEM_SYSRULES_richTextImage"(
            image: #"SYSTEM_SYSRULES_userImage"()
          ),
          ri!user
        }
      ),
      if(and(
          local!isUserOnTop = true,
          local!includeDateTime = true
        ),
        {
          char(10),
          #"_a-0000e68c-f08c-8000-9bbe-011c48011c48_4327183"(value: ri!dateTime, isVerbose: local!isVerboseDateTime, includeTimezone: ri!includeTimezone, isShortenedMonth: ri!isShortenedMonth, isDateOnly: ri!isDateOnly)
        },
        {}
      )
    }
  )
)</definition>
