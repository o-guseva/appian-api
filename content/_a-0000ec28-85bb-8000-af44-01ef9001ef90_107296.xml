        <definition>if(
  ri!showWhen &lt;&gt; false,
  if(
    ri!isReadOnly,
    #"_a-0000e77d-05a2-8000-9baf-011c48011c48_50461"(
      label: ri!label,
      value: ri!value,
      helpTooltip: ri!helpTooltip,
      widthLabel: ri!widthLabel,
      widthValue: ri!widthValue,
      labelPosition: ri!labelPosition,
      isSideBySide: ri!isSideBySide,
      align: ri!align
    ),
    #"SYSTEM_SYSRULES_textField"(
      label: ri!label,
      labelPosition: if(
        ri!isReadOnly,
        a!defaultValue(
          value: ri!labelPosition,
          default: #"_a-0000e712-ad81-8000-9ba5-011c48011c48_40791"
        ),
        ri!labelPosition
      ),
      instructions: ri!instructions,
      helpTooltip: ri!helpTooltip,
      placeholder: a!defaultValue(
        value: ri!placeholder,
        default: #"d5b22347-921f-47c4-a4df-d1a507c3f76b"(label: ri!label)
      ),
      value: #"_a-0000ec28-85bb-8000-af44-01ef9001ef90_107319"(
        value: if(
          a!isNotNullOrEmpty(ri!value),
          cleanwith(
            keyencrypt(ri!value),
            #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_58241"
          ),
          ""
        )
      ),
      saveInto: {
        a!save(
          ri!value,
          /*NEED TO ALSO SALT AFTER*/
          fn!sha256hash(
            datacleanwith(save!value, #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_58241")
          )
        ),
        ri!saveInto
      },
      refreshAfter: ri!refreshAfter,
      characterLimit: a!defaultValue(
        value: ri!characterLimit,
        default: #"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_59893"
      ),
      showCharacterCount: a!defaultValue(
        value: ri!showCharacterCount,
        default: false
      ),
      required: ri!isRequired,
      requiredMessage: ri!requiredMessage,
      readOnly: ri!isReadOnly,
      disabled: ri!isDisabled,
      masked: ri!masked,
      validationGroup: ri!validationGroup,
      validations: {
        if(
          isnull(ri!value),
          {},
          if(
            regexmatch("^\d{3}-\d{2}-\d{4}$", ri!value),
            {},
            "SSN must be entered as 123-12-1234"
          )
        ),
        ri!validations
      },
      align: ri!align,
      accessibilityText: a!defaultValue(
        value: ri!label,
        default: ri!accessibilityText
      ),
      inputPurpose: ri!inputPurpose
    )
  ),
  {}
)</definition>
