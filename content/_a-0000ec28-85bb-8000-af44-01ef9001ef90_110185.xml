        <definition>a!localVariables(
  /*DEFAULTS*/
  local!height: a!defaultValue(value: ri!height, default: "TALL"),
  local!characterLimit: a!defaultValue(value: ri!charLimit, default: #"_a-0000eb49-2433-8000-af2a-01ef9001ef90_25577"),
  local!characterLimitTruncate: a!defaultValue(value: ri!charLimitTruncate, default: #"_a-0000eb49-2433-8000-af2a-01ef9001ef90_25577"),
  local!accessibilityText: a!defaultValue(value: ri!accessibilityText, default: ri!label),
  local!isGridElement: a!defaultValue(value: ri!isGridElement, default: false),

  if(local!isGridElement,
    #"_a-0000e68c-f08c-8000-9bbe-011c48011c48_4327043"(
      label: ri!label,
      labelPosition: ri!labelPosition, 
      instructions: ri!instructions,
      helpTooltip: ri!helpTooltip,
      value: #"_a-0000ef0f-9abf-8000-af69-01ef9001ef90_276270"(value: ri!value),
      charLimit: local!characterLimitTruncate,
      isShowMoreOnNewLine: true
    ),
    #"SYSTEM_SYSRULES_styledTextEditorField"(
      label: ri!label,
      labelPosition: ri!labelPosition, 
      instructions: ri!instructions,
      helpTooltip: ri!helpTooltip,
      placeholder: a!defaultValue(
        value: ri!placeholder,
        default: #"d5b22347-921f-47c4-a4df-d1a507c3f76b"(label: ri!label)
      ),
      value: ri!value,
      saveInto: {
        if(ri!disableAutoSave, 
          {}, 
          ri!value
        ),
        if(ri!value = "&lt;p&gt;&lt;/p&gt;",
          a!save(ri!value, null),
          ri!value
        ),
        ri!saveInto
      },
      sizeLimit: if(
        ri!isReadOnly,
        null(),
        local!characterLimit
      ),
      height: local!height,
      showWhen: ri!showWhen,
      required: ri!isRequired,
      requiredMessage: ri!requiredMessage,
      readOnly: ri!isReadOnly,
      disabled: ri!isDisabled,
      validations: ri!validations,
      validationGroup: ri!validationGroup,
      accessibilityText: local!accessibilityText,
      marginAbove: ri!marginAbove,
      marginBelow: ri!marginBelow
    )
  )
)</definition>
