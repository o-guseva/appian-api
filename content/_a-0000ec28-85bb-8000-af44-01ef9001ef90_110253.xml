    <rule>
        <name>IEM_ICO_ENCRYPT_Ssn</name>
        <uuid>_a-0000ec28-85bb-8000-af44-01ef9001ef90_110253</uuid>
        <description>Encrypt/decrypt an SSN</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  /*Hash value*/
  local!hash: sha256hash(ri!value),
  /*Then salt value*/
  local!salt: 
  keyencrypt(
    local!hash, 
    #"_a-0000ec28-85bb-8000-af44-01ef9001ef90_110261",
    "SHA-1"
  ),
  local!salt
)</definition>
        <namedTypedValue>
            <name>value</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
