    <rule>
        <name>IEM_ICO_GET_AllUsers</name>
        <uuid>_a-0000ec28-85bb-8000-af44-01ef9001ef90_93098</uuid>
        <description>Retrieves all users</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!usersActive: if(ri!isActive &lt;&gt; false, getallusers(-1, -1), {}),
  local!usersInactive: if(ri!isActive &lt;&gt; true, getdeactivatedusersby("email", "@", 2), {}),
  a!flatten({local!usersActive, local!usersInactive})
)</definition>
        <namedTypedValue>
            <name>isActive</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
