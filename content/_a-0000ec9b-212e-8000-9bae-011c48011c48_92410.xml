            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(ri!showWhen = false, {}, 
  if(ri!isReadOnly,
    #"_a-0000e77d-05a2-8000-9baf-011c48011c48_50461"(
      label: ri!label,
      labelPosition: a!defaultValue(value: ri!labelPosition, default: "COLLAPSED"),
      value: {
        a!match(
          value: lower(ri!value),
          equals: "true",
          then: 
          #"SYSTEM_SYSRULES_richTextIcon"(
            icon: "check-square-o",
            color: "POSITIVE"
          ),
          equals: "false",
          then: 
          #"SYSTEM_SYSRULES_richTextIcon"(
            icon: "square-o"
          ),
          default: null
        ),
        " ",
        ri!choiceLabel
      },
      isTruncated: false,
      helpTooltip: ri!helpTooltip,
      tooltipLabel: ri!tooltipLabel,
      tooltipValue: ri!tooltipValue,
      widthLabel: ri!widthLabel,
      widthValue: ri!widthValue,
      isSideBySide: ri!isSideBySide
    ),
    #"_a-0000e77b-ae42-8000-9bae-011c48011c48_49198"(
      label: ri!label,
      labelPosition: a!defaultValue(value: ri!labelPosition, default: "COLLAPSED"),
      instructions: ri!instructions,
      helpTooltip: ri!helpTooltip,
      choiceLabels: { ri!choiceLabel },
      choiceValues: { true },
      value: if(ri!value = false, null, ri!value),
      saveInto: {
        a!save(
          ri!value,
          if(isnull(save!value), null, true)
        ),
        ri!saveInto
      },
      isRequired: ri!isRequired,
      isDisabled: ri!isDisabled,
      choiceLayout: "COMPACT",
      validations: ri!validations,
      validationGroup: ri!validationGroup
    )
  )
)</definition>
