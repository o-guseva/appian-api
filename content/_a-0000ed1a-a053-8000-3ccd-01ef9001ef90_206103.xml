        <name>IEM_ICO_BLN_IsDocExisting</name>
        <uuid>_a-0000ed1a-a053-8000-3ccd-01ef9001ef90_206103</uuid>
        <description>Checks if a document or if the given document in an array exists &lt;br&gt;
ri!index is optional</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(a!isNullOrEmpty(ri!doc),
  false,
  and(
    a!isNotNullOrEmpty(ri!doc),
    a!isNotNullOrEmpty(document(ri!doc, "url", ""))
  )
)</definition>
