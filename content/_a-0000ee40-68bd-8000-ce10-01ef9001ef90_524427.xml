    <rule>
        <name>IEM_ICO_FORMAT_ToYaml</name>
        <uuid>_a-0000ee40-68bd-8000-ce10-01ef9001ef90_524427</uuid>
        <description>Formats an Appian object to YAML</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(a!isNullOrEmpty(ri!value),
  null,
  jsontoyaml(#"SYSTEM_SYSRULES_toJson_v1"(ri!value))
)</definition>
        <namedTypedValue>
            <name>value</name>
            <description>YAML single string</description>
            <type>
                <name>Variant</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
