        <definition>if(ri!showWhen &lt;&gt; false,
  a!localVariables(
    /*DEFAULTS*/
    local!labelPosition: a!defaultValue(value: ri!labelPosition, default: "COLLAPSED"),
    local!align: a!defaultValue(value: ri!align, default: "CENTER"),
    local!color: a!defaultValue(value: ri!color, default: "ACCENT"),
    
    #"SYSTEM_SYSRULES_richTextDisplayField"(
      tooltip: ri!toolTip,
      labelPosition: local!labelPosition,
      value: 
      if(a!isNullOrEmpty(ri!icon),
      {},
      #"SYSTEM_SYSRULES_richTextIcon"(
        icon: ri!icon,
        caption: striphtml(ri!toolTip),
        size: ri!size,
        color: local!color,
        linkStyle: ri!linkStyle,
        link: ri!link
      )
      ),
      align: local!align
    )
  ), {}
)</definition>
