        <definition>if(ri!showWhen &lt;&gt; false,
  a!localVariables(
    /*DEFAULTS*/
    local!showIcon: a!defaultValue(value: ri!showIcon, default: true),
    local!showBorder: a!defaultValue(value: ri!showBorder, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_191416"),
    local!showShadow: a!defaultValue(value: ri!showShadow, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_191409"),
    local!padding: a!defaultValue(value: ri!padding, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_191392"),
    local!marginBelow: a!defaultValue(value: ri!marginBelow, default: #"_a-0000ee9a-01f5-8000-af67-01ef9001ef90_191368"),
    local!decorativeBarPosition: a!defaultValue(value: ri!decorativeBarPosition, default: "START"),
    local!decorativeBarColor: a!defaultValue(value: ri!decorativeBarColor, default: null),
    local!style: a!defaultValue(value: ri!style, default: "NONE"),
    
    #"SYSTEM_SYSRULES_cardLayout"(
      contents: {
        #"SYSTEM_SYSRULES_sideBySideLayout"(
          items: {
            #"SYSTEM_SYSRULES_sideBySideItem"(
              item: 
              #"SYSTEM_SYSRULES_richTextDisplayField"(
                labelPosition: "COLLAPSED",
                value: ri!richTextIcon,
                preventWrapping: true
              ),
              width: "MINIMIZE",
              showWhen: local!showIcon
            ),
            #"SYSTEM_SYSRULES_sideBySideItem"(
              item: 
              #"SYSTEM_SYSRULES_richTextDisplayField"(
                labelPosition: "COLLAPSED",
                value: {
                  ri!richTextMsgPrimary,
                  if(a!isNullOrEmpty(ri!richTextMsgSecondary),
                  {},
                  {
                    char(10),
                    ri!richTextMsgSecondary
                  }
                  )
                }
              ),
              width: "AUTO"
            )
          },
          alignVertical: "MIDDLE",
          spacing: "SPARSE",
          marginBelow: "NONE"
        ),
        #"_a-0000e712-ad81-8000-9ba5-011c48011c48_36733"(
          contents: ri!contents,
          numColumns: a!defaultValue(value: ri!numColumns, default: 1),
          width: ri!widths,
          marginBelow: "NONE"
        )
      },
      link: ri!link,
      style: local!style,
      padding: local!padding,
      marginBelow: local!marginBelow,
      showBorder: local!showBorder,
      showShadow: local!showShadow,
      decorativeBarPosition: local!decorativeBarPosition,
      decorativeBarColor: local!decorativeBarColor
    )
  ), {}
)</definition>
