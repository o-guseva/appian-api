    <rule>
        <name>IEM_ICO_FORMAT_DocumentSize</name>
        <uuid>_a-0000ef0f-9abf-8000-af69-01ef9001ef90_284107</uuid>
        <description>Binary Conversion of Bytes to something readable</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  /*DEFAULTS*/
  local!value: a!defaultValue(value: ri!value, default: 0),
  local!format: a!defaultValue(value: ri!format, default: "MB"),
  if(local!value = 0,
    local!value &amp; " " &amp; local!format,
    a!match(
      value: ri!format,
      equals: "KB",
      then: tostring(text(ri!value * 0.0009765625, "0.00")) &amp; " KB",
      equals: "GB",
      then: tostring(text(ri!value * 0.00000000093132257461548, "0.00")) &amp; " GB",
      default: tostring(text(ri!value * 0.00000095367432, "0.00")) &amp; " MB",
    )
  )
)</definition>
        <namedTypedValue>
            <name>value</name>
            <description>Must be in Bytes</description>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>format</name>
            <description>Must be KB, MB, or GB</description>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
