        <definition>if(ri!showWhen &lt;&gt; false,
  a!localVariables(
    /*DEFAULTS*/
    local!linkStyle: a!defaultValue(value: ri!linkStyle, default: "STANDALONE"),
    
    {
      #"SYSTEM_SYSRULES_richTextIcon"(
        icon: "external-link",
        altText: "External link",
        size: ri!size,
        color: ri!color,
        link: ri!link,
        linkStyle: local!linkStyle
      ),

      #"SYSTEM_SYSRULES_richTextItem_v1"(
        text: " " &amp; ri!label,
        size: ri!size,
        color: ri!color,
        link: ri!link,
        linkStyle: local!linkStyle
      )
    }
  ), {}
)</definition>
