<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000efa8-4346-8000-3cdd-01ef9001ef90_250616</versionUuid>
    <rule>
        <name>IEM_ICO_FORMAT_RecordSyncProperty</name>
        <uuid>_a-0000efa8-4346-8000-3cdd-01ef9001ef90_250563</uuid>
        <description>Given a RecordType UUID, returns the string necessary to force a record sync in a properties deployment file</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(a!isNullOrEmpty(ri!uuid),
  tostring(null),
  concat("recordType.", ri!uuid, ".forceSync=true")
)</definition>
        <namedTypedValue>
            <name>uuid</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
