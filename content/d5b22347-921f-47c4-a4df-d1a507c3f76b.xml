<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000ee9a-01f5-8000-af67-01ef9001ef90_193889</versionUuid>
    <rule>
        <name>IEM_ICO_GENERATE_PlaceholderFromLabel</name>
        <uuid>d5b22347-921f-47c4-a4df-d1a507c3f76b</uuid>
        <description>chooses correct placeholder based on whether or not the label begins with a consonant or a vowel</description>
        <parentUuid>_a-0000e2c3-93ef-8000-9ba2-011c48011c48_2351149</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  /*DEFAULTS*/
  local!label: a!defaultValue(value: ri!label, default: "value"),
  local!verb: a!defaultValue(value: ri!verb, default: "Enter"),
  
  a!match(
    value: ri!label,
    whenTrue: regexmatch(#"_a-0000eaa5-7858-8000-3c9d-01ef9001ef90_57983", local!label),
    then: "-- " &amp; local!verb &amp; " an " &amp; local!label &amp; " --", 
    default: "-- " &amp; local!verb &amp; " a " &amp; local!label &amp; " --"
  )

)</definition>
        <namedTypedValue>
            <name>label</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>verb</name>
            <description>DEFAULT: Enter</description>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
